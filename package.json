{
  "name": "aiflowbridge",
  "displayName": "AIFlowBridge - DeepSeek V4, MiniMax M3 & MiMo in Copilot Chat",
  "description": "Multi-provider AI switcher for GitHub Copilot Chat: DeepSeek V4 ($0.27/M in), MiniMax M3, Xiaomi MiMo V2 Omni. 3 problems solved: (1) one Copilot Chat picker for 14 models across 3 vendors, (2) free vision for text-only models via a transparent proxy to your Copilot-bundled vision model, (3) a built-in OpenAI-compatible local gateway on port 8787 so Kilo Code, Continue, Open WebUI, and curl can all use the same models - with a live metrics dashboard, per-request token counts, and estimated cost. Free, open-source, ad-free, no data collection. Pay only the upstream providers you use.",
  "version": "2.1.1",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "qna": "https://github.com/LaurentOngaro/aiflowbridge/discussions",
  "icon": "resources/icon.png",
  "publisher": "LaurentOngaro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LaurentOngaro/aiflowbridge"
  },
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "chat",
    "deepseek",
    "deepseek-v4",
    "minimax",
    "minimax-m3",
    "xiaomi",
    "mimo",
    "copilot",
    "copilot-chat",
    "copilot-alternative",
    "vision",
    "vision-proxy",
    "proxy",
    "metrics",
    "llm",
    "language-model",
    "coding-assistant",
    "openai-compatible",
    "openai",
    "ollama",
    "kilocode",
    "continue",
    "gpt",
    "claude",
    "agent-mode",
    "cost",
    "token-tracking",
    "multi-provider",
    "gateway"
  ],
  "activationEvents": [
    "onLanguageModelChatProvider:aiflowbridge"
  ],
  "main": "./out/extension.js",
  "bin": {
    "aiflowbridge-server": "./dist/standalone/main.js"
  },
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "aiflowbridge",
        "displayName": "AIFlowBridge"
      }
    ],
    "commands": [
      {
        "command": "aiflowbridge.refreshMetrics",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Refresh metrics"
      },
      {
        "command": "aiflowbridge.resetMetrics",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Reset metrics"
      },
      {
        "command": "aiflowbridge.showMetrics",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Show metrics dashboard"
      },
      {
        "command": "aiflowbridge.startGateway",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Start local gateway"
      },
      {
        "command": "aiflowbridge.stopGateway",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Stop local gateway"
      },
      {
        "command": "aiflowbridge.copyGatewayUrl",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Copy gateway URL"
      },
      {
        "command": "aiflowbridge.openSettings",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Open settings"
      },
      {
        "command": "aiflowbridge.joinExternalGateway",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Join external (standalone) gateway"
      },
      {
        "command": "aiflowbridge.setVisionModel",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Set vision proxy model"
      },
      {
        "command": "aiflowbridge.showLogs",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Show logs"
      },
      {
        "command": "aiflowbridge.openRequestDumpsFolder",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Open request dumps folder"
      },
      {
        "command": "aiflowbridge.addCustomModel",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Add a custom model"
      },
      {
        "command": "aiflowbridge.editModelRegistry",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Edit model registry"
      },
      {
        "command": "aiflowbridge.resetModelRegistry",
        "category": "AIFlowBridge",
        "title": "AIFlowBridge: Reset model registry to bundled defaults"
      },
      {
        "command": "aiflowbridge.providers.deepseek.setApiKey",
        "category": "AIFlowBridge",
        "title": "DeepSeek: Set API Key"
      },
      {
        "command": "aiflowbridge.providers.deepseek.clearApiKey",
        "category": "AIFlowBridge",
        "title": "DeepSeek: Clear API Key"
      },
      {
        "command": "aiflowbridge.providers.minimax.setApiKey",
        "category": "AIFlowBridge",
        "title": "MiniMax: Set API Key"
      },
      {
        "command": "aiflowbridge.providers.minimax.clearApiKey",
        "category": "AIFlowBridge",
        "title": "MiniMax: Clear API Key"
      },
      {
        "command": "aiflowbridge.providers.xiaomi.setApiKey",
        "category": "AIFlowBridge",
        "title": "Xiaomi MiMo: Set API Key"
      },
      {
        "command": "aiflowbridge.providers.xiaomi.clearApiKey",
        "category": "AIFlowBridge",
        "title": "Xiaomi MiMo: Clear API Key"
      },
      {
        "command": "aiflowbridge.providers.deepseek.setVisionModel",
        "category": "AIFlowBridge",
        "title": "DeepSeek: Set vision proxy model"
      }
    ],
    "keybindings": [
      {
        "command": "aiflowbridge.showMetrics",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      }
    ],
    "configuration": {
      "title": "AIFlowBridge",
      "properties": {
        "aiflowbridge.gateway.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the local gateway automatically on extension activation"
        },
        "aiflowbridge.gateway.port": {
          "type": "number",
          "default": 8787,
          "minimum": 1,
          "maximum": 65535,
          "description": "Local port exposed by the gateway"
        },
        "aiflowbridge.gateway.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787/v1",
          "description": "OpenAI-compatible base URL exposed to AI clients"
        },
        "aiflowbridge.gateway.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default logical model name when the client does not specify one"
        },
        "aiflowbridge.gateway.probeTimeoutMs": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 10000,
          "description": "Timeout (ms) for probing a peer gateway's /version endpoint on port conflict. Higher values tolerate slower peer startups; lower values fail fast on a foreign service."
        },
        "aiflowbridge.gateway.maxConcurrentRequests": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum number of upstream /v1/chat/completions requests in flight. Requests above the limit return HTTP 429. Protects the upstream from a runaway local client."
        },
        "aiflowbridge.providers": {
          "type": "array",
          "default": [],
          "description": "Logical upstream provider profiles routed by the proxy",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "kind",
              "baseUrl",
              "model"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable provider identifier"
              },
              "label": {
                "type": "string",
                "description": "Human-readable name"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "openai-compat",
                  "ollama"
                ],
                "description": "Upstream provider kind"
              },
              "baseUrl": {
                "type": "string",
                "description": "Base URL for the upstream provider"
              },
              "model": {
                "type": "string",
                "description": "Concrete upstream model name"
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Enable or disable this provider profile"
              },
              "pricing": {
                "type": "object",
                "properties": {
                  "inputPerMillion": {
                    "type": "number"
                  },
                  "outputPerMillion": {
                    "type": "number"
                  },
                  "currency": {
                    "type": "string",
                    "default": "USD"
                  }
                }
              }
            }
          }
        },
        "aiflowbridge.providers.deepseek.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "DeepSeek API base URL"
        },
        "aiflowbridge.providers.deepseek.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum tokens per response (0 = default)"
        },
        "aiflowbridge.providers.deepseek.modelIdOverrides": {
          "type": "object",
          "default": {},
          "description": "Model ID overrides for DeepSeek models"
        },
        "aiflowbridge.providers.minimax.baseUrl": {
          "type": "string",
          "default": "https://api.minimax.io/v1",
          "description": "MiniMax API base URL"
        },
        "aiflowbridge.providers.minimax.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum tokens per response (0 = default)"
        },
        "aiflowbridge.providers.minimax.modelIdOverrides": {
          "type": "object",
          "default": {},
          "description": "Model ID overrides for MiniMax models"
        },
        "aiflowbridge.providers.minimax.temperature": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for MiniMax requests"
        },
        "aiflowbridge.providers.minimax.topP": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 1,
          "description": "Nucleus sampling parameter for MiniMax requests"
        },
        "aiflowbridge.providers.minimax.reasoningSplit": {
          "type": "boolean",
          "default": true,
          "description": "Enable reasoning split streaming for MiniMax"
        },
        "aiflowbridge.providers.xiaomi.baseUrl": {
          "type": "string",
          "default": "https://api.xiaomimimo.com/v1",
          "description": "Xiaomi MiMo-API base URL"
        },
        "aiflowbridge.providers.xiaomi.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum tokens per response (0 = default)"
        },
        "aiflowbridge.providers.xiaomi.modelIdOverrides": {
          "type": "object",
          "default": {},
          "description": "Model ID overrides for Xiaomi MiMo models"
        },
        "aiflowbridge.providers.xiaomi.reasoningRequiredForToolCalls": {
          "type": "boolean",
          "default": true,
          "description": "Replay reasoning_content in tool-call followups to satisfy MiMo API requirements"
        },
        "aiflowbridge.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable local usage telemetry"
        },
        "aiflowbridge.telemetry.logRequests": {
          "type": "boolean",
          "default": true,
          "description": "Log each request handled by the gateway"
        },
        "aiflowbridge.vision.excludedVendors": {
          "type": "array",
          "default": [
            "aiflowbridge"
          ],
          "description": "Vendors that should NOT use the vision proxy"
        },
        "aiflowbridge.vision.copilotVisionModel": {
          "type": "string",
          "default": "oswe-vscode-prime",
          "description": "Model to use for vision proxy in GitHub Copilot"
        },
        "aiflowbridge.userModels": {
          "type": "array",
          "default": [],
          "description": "User-defined models merged with built-in models. Each entry follows the ModelDefinition shape (id, name, family, version, detail, maxInputTokens, maxOutputTokens, capabilities, requiresThinkingParam).",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "family",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique model ID (must match what the upstream API expects)"
              },
              "name": {
                "type": "string",
                "description": "Display name shown in the Copilot Chat model picker"
              },
              "family": {
                "type": "string",
                "enum": [
                  "deepseek",
                  "minimax",
                  "xiaomi"
                ],
                "description": "Provider family"
              },
              "version": {
                "type": "string"
              },
              "detail": {
                "type": "string",
                "description": "Short description (fallback: built-in detail for the same family)"
              },
              "maxInputTokens": {
                "type": "number",
                "minimum": 1,
                "description": "Max input context (fallback: 128000)"
              },
              "maxOutputTokens": {
                "type": "number",
                "minimum": 1,
                "description": "Max output tokens (fallback: 8192)"
              },
              "capabilities": {
                "type": "object",
                "properties": {
                  "toolCalling": {
                    "type": [
                      "boolean",
                      "number"
                    ],
                    "description": "true=unlimited, false=disabled, number=limit"
                  },
                  "imageInput": {
                    "type": "boolean"
                  },
                  "thinking": {
                    "type": "boolean"
                  }
                }
              },
              "requiresThinkingParam": {
                "type": "boolean",
                "description": "Whether the upstream requires an explicit thinking param"
              }
            }
          }
        },
        "aiflowbridge.vision.prompt": {
          "type": "string",
          "default": "Describe all image attachments in this message.\n\nIf there is one image, describe it directly.\nIf there are multiple images:\n1. Describe each image separately, preserving their order.\n2. Then provide a combined description explaining the overall context.\n\nReturn one concise factual description suitable for inserting into a text-only chat prompt.",
          "description": "Prompt used for vision proxy image descriptions"
        },
        "aiflowbridge.debugMode": {
          "type": "string",
          "default": "minimal",
          "enum": [
            "minimal",
            "metadata",
            "verbose"
          ],
          "description": "Debug mode for extension diagnostics"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "aiflowbridge.showMetrics",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "clean:standalone": "node -e \"require('node:fs').rmSync('dist/standalone', { recursive: true, force: true })\" && node -e \"require('node:fs').rmSync('dist/aiflowbridge', { recursive: true, force: true })\" && node -e \"require('node:fs').rmSync('dist/logger.js', { force: true })\" && node -e \"require('node:fs').rmSync('dist/config.js', { force: true })\" && node -e \"require('node:fs').rmSync('dist/consts.js', { force: true })\" && node -e \"require('node:fs').rmSync('dist/types.js', { force: true })\" && node -e \"require('node:fs').rmSync('dist/json.js', { force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "compile:standalone": "npm run clean:standalone && tsc -p tsconfig.standalone.json && tsc-alias -p tsconfig.standalone.json && node -e \"require('node:fs').chmodSync('dist/standalone/main.js', 0o755)\" && node -e \"const fs=require('node:fs');const s=fs.statSync('dist/standalone/main.js');console.log('[build:standalone] OK - dist/standalone/main.js (' + s.size + ' bytes)')\"",
    "watch": "npm run clean && tsc -watch -p ./",
    "build:standalone": "npm run compile:standalone",
    "start:standalone": "node dist/standalone/main.js",
    "package": "npm run compile && npm test && vsce package -o dist/",
    "publish:vscode": "npm run compile && npm test && vsce publish",
    "publish:openvsx": "npm run compile && npm test && ovsx publish",
    "publish:all": "npm run publish:vscode && npm run publish:openvsx",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "ovsx": "^1.0.1",
    "tsc-alias": "^1.9.0",
    "typescript": "^6.0.3",
    "vitest": "^2.0.5"
  }
}