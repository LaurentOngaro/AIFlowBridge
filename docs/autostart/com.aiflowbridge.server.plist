<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aiflowbridge.server</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Run `command -v node` and paste the result here: /opt/homebrew/bin/node on Apple Silicon, /usr/local/bin/node on Intel. -->
    <string>/usr/local/bin/node</string>
    <string>/path/to/AIFlowBridge/dist/standalone/main.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/path/to/AIFlowBridge</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- API keys. Replace with your real values. Prefer the macOS Keychain (e.g. `security find-generic-password -s AIFLOWBRIDGE_DEEPSEEK_API_KEY -w`) over inlining secrets here. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>AIFLOWBRIDGE_DEEPSEEK_API_KEY</key>
    <string>sk-replace-me</string>
    <key>AIFLOWBRIDGE_MINIMAX_API_KEY</key>
    <string>replace-me</string>
    <key>AIFLOWBRIDGE_XIAOMI_API_KEY</key>
    <string>replace-me</string>
    <key>AIFLOWBRIDGE_ZAI_API_KEY</key>
    <string>replace-me</string>
    <key>AIFLOWBRIDGE_MOONSHOT_API_KEY</key>
    <string>replace-me</string>
    <!-- Workspace used by the context detector. launchd starts the process from the install directory, so set it explicitly if you want the detector to walk a real project. -->
    <!-- <key>AIFLOWBRIDGE_WORKSPACE</key> -->
    <!-- <string>/Users/youruser/projects/my-app</string> -->
    <!-- Storage dir. When omitted, the VS Code extension's globalStorage folder wins if it exists on this machine, otherwise ~/.aiflowbridge/. -->
    <!-- <key>AIFLOWBRIDGE_DATA_DIR</key> -->
    <!-- <string>/Users/youruser/.aiflowbridge</string> -->
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/com.aiflowbridge.server.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.aiflowbridge.server.err.log</string>
</dict>
</plist>