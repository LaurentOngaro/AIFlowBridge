.vscode/**
.github/**
.vscode-test/**
.dev/**
.kilo/**

dist/**
src/**
node_modules/**
# keep the runtime deps pulled in via `bundledDependencies`
# (`installStandalone` does dynamic `await import("adm-zip")` /
# `await import("tar")`, so the published VSIX must carry the
# modules on disk). The default `node_modules/**` rule above
# would otherwise erase them; the two `!` re-include lines undo
# it for exactly what is packaged.
!node_modules/adm-zip/**
!node_modules/tar/**

# FEAT7: standalone gateway - shipped separately as an npm binary,
# never bundled in the VSIX.
dist/standalone/**
src/standalone/**
tsconfig.standalone.json

out/**/*.map
out/**/*.d.ts
out/**/*.d.ts.map

# Development-only payload. These files are needed to build or to work on
# the extension, never to run it, and the project journal has no business
# shipping to every Marketplace user. Measured on the 2.16.1 artifact:
# tests/ was 753 KB across 64 files, TODO.md 36 KB, BRAIN.md 10.6 KB,
# ACTION_PLAN.md 8.7 KB, scripts/ 13.4 KB, plus the git hook and the Kilo
# rule file. `docs/**` is deliberately NOT excluded: it is the end-user
# documentation that ships with the extension.
tests/**
scripts/**
.githooks/**
.kilocode/**
BRAIN.md
ACTION_PLAN.md
TODO.md
.kilo/**

.nvmrc
.gitignore
*.vsix
AGENTS.md
tsconfig.json
vscode.proposed.languageModelThinkingPart.d.ts
package-lock.json
.DS_Store

.env*
!.env.example
_helpers/**
_Private/**
